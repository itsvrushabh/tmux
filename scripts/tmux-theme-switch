#!/usr/bin/env bash
set -euo pipefail

THEMES=(cyberpunk tokyo-night catppuccin-mocha gruvbox-dark nord)

current="$(tmux show-option -gqv @tmux_theme || true)"
if [[ "${1:-}" == "apply" ]]; then
  theme="${current:-${THEMES[0]}}"
else
  next_idx=0
  for i in "${!THEMES[@]}"; do
    if [[ "${THEMES[$i]}" == "$current" ]]; then
      next_idx=$(( (i + 1) % ${#THEMES[@]} ))
      break
    fi
  done
  theme="${THEMES[$next_idx]}"
fi

case "$theme" in
  cyberpunk)
    bg="#0d0d0d"; bg_alt="#1a1a2e"; fg="#00d7ff"; accent="#00ff87"
    dim="#6a6a8a"; warn="#ffaf00"; err="#ff5f5f"
    bash_fg="0;215;255"; bash_ok="0;255;135"; bash_err="255;95;95"; bash_git="175;95;255"
    ;;
  tokyo-night)
    bg="#1a1b26"; bg_alt="#24283b"; fg="#7aa2f7"; accent="#9ece6a"
    dim="#565f89"; warn="#e0af68"; err="#f7768e"
    bash_fg="122;162;247"; bash_ok="158;206;106"; bash_err="247;118;142"; bash_git="224;175;104"
    ;;
  catppuccin-mocha)
    bg="#1e1e2e"; bg_alt="#313244"; fg="#89b4fa"; accent="#a6e3a1"
    dim="#6c7086"; warn="#f9e2af"; err="#f38ba8"
    bash_fg="137;180;250"; bash_ok="166;227;161"; bash_err="243;139;168"; bash_git="249;226;175"
    ;;
  gruvbox-dark)
    bg="#282828"; bg_alt="#3c3836"; fg="#83a598"; accent="#b8bb26"
    dim="#928374"; warn="#fabd2f"; err="#fb4934"
    bash_fg="131;165;152"; bash_ok="184;187;38"; bash_err="251;73;52"; bash_git="250;189;47"
    ;;
  nord)
    bg="#2e3440"; bg_alt="#3b4252"; fg="#88c0d0"; accent="#a3be8c"
    dim="#616e88"; warn="#ebcb8b"; err="#bf616a"
    bash_fg="136;192;208"; bash_ok="163;190;140"; bash_err="191;97;106"; bash_git="235;203;139"
    ;;
esac

mkdir -p "$HOME/.cache"
cat > "$HOME/.cache/tmux-theme.sh" <<EOF
# Auto-generated by tmux-theme-switch ($theme)
Cyan='\[\e[38;2;${bash_fg}m\]'
Green='\[\e[38;2;${bash_ok}m\]'
Red='\[\e[38;2;${bash_err}m\]'
Yellow='\[\e[38;2;${bash_git}m\]'
PS1="\$(prompt_status \$?) \${Cyan}\w\${Yellow}\$(parse_git_branch)\${Reset} "
EOF

tmux set -g @tmux_theme "$theme"

tmux set -g popup-style "bg=${bg},fg=${fg}"
tmux set -g popup-border-style "fg=${dim},bg=${bg}"
tmux set -g menu-style "bg=${bg},fg=${dim}"
tmux set -g menu-selected-style "bg=${bg_alt},fg=${fg},bold"
tmux set -g menu-border-style "fg=${dim},bg=${bg}"
tmux set -g message-style "bg=${bg_alt},fg=${fg},bold"
tmux set -g mode-style "bg=${bg_alt},fg=${accent},bold"

tmux set -g status-style "bg=${bg},fg=${dim}"
tmux set -g window-status-format "#[fg=${dim}][#I]"
tmux set -g window-status-current-format "#[fg=${dim}][#{?client_prefix,#[fg=${err}]⌨ ,#[fg=${accent}]⚡}#[fg=${fg},bold]#[fg=${dim},nobold]#[fg=${fg},bold]#[fg=${dim},nobold]]"
tmux set -g status-right "#($HOME/.local/bin/sys-stats.sh) #[fg=${dim}][#[fg=${fg},bold]%H:%M#[fg=${dim},nobold]] #[fg=${dim}]◈ #P "
tmux set -g "status-format[0]" "#[align=left]#{T:status-left}#{W:#{E:window-status-format}#{T:window-status-separator},#{E:window-status-current-format}#{T:window-status-separator}}#[align=centre]#{?#{||:#{@notify_count},#{@whisper_status}},#[fg=${bg_alt}]#[bg=${bg}]#[bg=${bg_alt}] #{@whisper_status}#{?#{@notify_count},#[fg=${warn}]#[bold]󰂚 #{@notify_count}#[nobold]#{?#{@notify_preview}, #[fg=${fg}]#{@notify_preview},},} #[fg=${bg_alt}]#[bg=${bg}],#[fg=${bg_alt}]#[bg=${bg}]#[bg=${bg_alt}]#[fg=${dim}] ◈ #[fg=${bg_alt}]#[bg=${bg}]}#[align=right]#{T:status-right}"

if [[ "${1:-}" != "apply" ]]; then
  tmux display-message "Theme: ${theme}"
fi
